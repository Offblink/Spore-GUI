<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context
        http://www.springframework.org/schema/context/spring-context.xsd
        http://www.springframework.org/schema/mvc
        http://www.springframework.org/schema/mvc/spring-mvc.xsd">

  <!-- =====================================================================
       子容器（DispatcherServlet 装配）：Controller + 全局异常 + MVC 装配。
       Service/Mapper/切面在父容器，这里只管 HTTP 层。

       注意：这里的 <mvc:annotation-driven/> 装的是裸的 RequestMappingHandlerMapping/Adapter，
       **不认 WebMvcConfigurer**（那套要 DelegatingWebMvcConfiguration/@EnableWebMvc，是 Boot 的路子）。
       所以拦截器、CORS、消息转换器一律走本文件的 XML 元素——严格 SSM 就该这么配。
       ===================================================================== -->

  <!-- Controller 与 @RestControllerAdvice 全局异常处理 -->
  <context:component-scan base-package="com.offblink.spore.controller,
                                        com.offblink.spore.common"/>

  <!-- multipart：与 web.xml 的 <multipart-config> 配套（题图上推） -->
  <bean id="multipartResolver"
        class="org.springframework.web.multipart.support.StandardServletMultipartResolver"/>

  <!-- 注解驱动。消息转换器：Jackson 换成父容器 ObjectMapper（JacksonConfig）——
       日期格式/时区/未知字段口径与 Boot 时代逐条对齐，也和 LogAspect 手里那个同一套；
       register-defaults 默认 true，字符串/字节等默认转换器照常补在后面。 -->
  <mvc:annotation-driven>
    <mvc:message-converters>
      <bean class="org.springframework.http.converter.json.MappingJackson2HttpMessageConverter">
        <property name="objectMapper" ref="objectMapper"/>
      </bean>
    </mvc:message-converters>
  </mvc:annotation-driven>

  <!-- CORS：/api/** 允许任意来源（ApiFox 与手机跨域联调）。
       allowed-origin-patterns="*" 才能配 allow-credentials=true——
       allowed-origins="*" 加凭据在 Spring 5.3 直接被判非法。 -->
  <mvc:cors>
    <mvc:mapping path="/api/**"
                allowed-origin-patterns="*"
                allowed-methods="GET,POST,PUT,DELETE,OPTIONS"
                allowed-headers="*"
                allow-credentials="true"/>
  </mvc:cors>

  <!-- 登录拦截器：除注册/登录/设备登录外全部要求 Bearer token（服务端唯一闸门）。
       <ref> 指向父容器那个 @Component AuthInterceptor，别再 new 一个。 -->
  <mvc:interceptors>
    <mvc:interceptor>
      <mvc:mapping path="/api/**"/>
      <mvc:exclude-mapping path="/api/auth/register"/>
      <mvc:exclude-mapping path="/api/auth/login"/>
      <mvc:exclude-mapping path="/api/auth/device-login"/>
      <ref bean="authInterceptor"/>
    </mvc:interceptor>
  </mvc:interceptors>

  <!-- 没有映射的路径交给 Tomcat 默认 Servlet（favicon 等）。
       MappedInterceptor 对它同样生效 → 未命中的 /api/** 照旧被拦成 401（与 Boot 时代一致）。 -->
  <mvc:default-servlet-handler/>
</beans>
