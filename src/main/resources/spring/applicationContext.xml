<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:aop="http://www.springframework.org/schema/aop"
       xmlns:tx="http://www.springframework.org/schema/tx"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context
        http://www.springframework.org/schema/context/spring-context.xsd
        http://www.springframework.org/schema/aop
        http://www.springframework.org/schema/aop/spring-aop.xsd
        http://www.springframework.org/schema/tx
        http://www.springframework.org/schema/tx/spring-tx.xsd">

  <!-- =====================================================================
       父容器（ContextLoaderListener 装配）：Service / Mapper / 切面 / 数据源。
       Controller 与 MVC 相关的 Bean 一律在 spring-mvc.xml 的子容器里，父子各扫各的。
       ===================================================================== -->

  <!-- 业务层 + 切面 + 安全（TokenService/AuthInterceptor 被子容器引用：子看得到父） -->
  <context:component-scan base-package="com.offblink.spore.service,
                                        com.offblink.spore.aspect,
                                        com.offblink.spore.security"/>

  <!-- 配置类：数据源（含首启自动建库）、MyBatis-Plus 插件、自动填充、Jackson、属性装载 -->
  <context:component-scan base-package="com.offblink.spore.config"/>

  <!-- ============ MyBatis-Plus 装配（对应 Boot 的 mybatis-plus.* 配置段） ============ -->
  <!-- 分页插件：MybatisPlusConfig#mybatisPlusInterceptor -->
  <bean id="mybatisConfiguration" class="com.baomidou.mybatisplus.core.MybatisConfiguration">
    <!-- mybatis-plus.configuration.map-underscore-to-camel-case -->
    <property name="mapUnderscoreToCamelCase" value="true"/>
    <!-- mybatis-plus.configuration.log-impl：控制台 SQL 日志（实验报告截图要含 SQL 日志） -->
    <property name="logImpl" value="org.apache.ibatis.logging.stdout.StdOutImpl"/>
  </bean>

  <!-- mybatis-plus.global-config.db-config：六表统一逻辑删除列 + 主键策略 -->
  <bean id="mybatisDbConfig"
        class="com.baomidou.mybatisplus.core.config.GlobalConfig$DbConfig">
    <property name="logicDeleteField" value="deleted"/>
    <property name="logicDeleteValue" value="1"/>
    <property name="logicNotDeleteValue" value="0"/>
    <property name="idType" value="AUTO"/>
  </bean>
  <bean id="mybatisGlobalConfig" class="com.baomidou.mybatisplus.core.config.GlobalConfig">
    <property name="banner" value="false"/>
    <property name="dbConfig" ref="mybatisDbConfig"/>
    <!-- mybatis-plus.meta-object-handler：update_time 自动填充（评分表三·数据自动填充） -->
    <property name="metaObjectHandler" ref="metaFillHandler"/>
  </bean>

  <bean id="sqlSessionFactory"
        class="com.baomidou.mybatisplus.extension.spring.MybatisSqlSessionFactoryBean">
    <property name="dataSource" ref="dataSource"/>
    <property name="configuration" ref="mybatisConfiguration"/>
    <property name="globalConfig" ref="mybatisGlobalConfig"/>
    <property name="plugins" ref="mybatisPlusInterceptor"/>
    <!-- XML 里的动态 SQL（SyncMapper.xml 等） -->
    <property name="mapperLocations" value="classpath*:mapper/*.xml"/>
  </bean>

  <!-- Mapper 接口扫进容器（取代 @MapperScan） -->
  <bean class="org.mybatis.spring.mapper.MapperScannerConfigurer">
    <property name="basePackage" value="com.offblink.spore.mapper"/>
    <property name="sqlSessionFactoryBeanName" value="sqlSessionFactory"/>
  </bean>

  <!-- ============ 事务 ============ -->
  <bean id="transactionManager"
        class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
    <property name="dataSource" ref="dataSource"/>
  </bean>
  <!-- proxy-target-class：与 Boot 时代一致用 CGLIB（注入点若写实现类也不会炸） -->
  <tx:annotation-driven transaction-manager="transactionManager"
                        proxy-target-class="true"/>

  <!-- ============ AOP：@Aspect 注解切面生效（权限校验 + 操作日志） ============ -->
  <aop:aspectj-autoproxy proxy-target-class="true"/>
</beans>
