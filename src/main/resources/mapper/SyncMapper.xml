<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.offblink.spore.mapper.SyncMapper">

  <!-- 同步增量查询：不加 deleted 过滤——墓碑必须下发（design/02 §4）。
       content 列要走 JacksonTypeHandler，故手写 resultMap（BaseMapper 的 autoResultMap 覆盖不到自定义 SQL）。 -->
  <resultMap id="articleMap" type="com.offblink.spore.entity.Article">
    <id property="id" column="id"/>
    <result property="userId" column="user_id"/>
    <result property="categoryId" column="category_id"/>
    <result property="title" column="title"/>
    <result property="content" column="content"
            typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
    <result property="fav" column="fav"/>
    <result property="status" column="status"/>
    <result property="auditStatus" column="audit_status"/>
    <result property="origin" column="origin"/>
    <result property="attachmentPath" column="attachment_path"/>
    <result property="createdTime" column="created_time"/>
    <result property="updateTime" column="update_time"/>
    <result property="deleted" column="deleted"/>
  </resultMap>

  <resultMap id="categoryMap" type="com.offblink.spore.entity.Category">
    <id property="id" column="id"/>
    <result property="userId" column="user_id"/>
    <result property="parentId" column="parent_id"/>
    <result property="name" column="name"/>
    <result property="sortOrder" column="sort_order"/>
    <result property="status" column="status"/>
    <result property="createdTime" column="created_time"/>
    <result property="updateTime" column="update_time"/>
    <result property="deleted" column="deleted"/>
  </resultMap>

  <select id="selectCategoriesSince" resultMap="categoryMap">
    SELECT *
    FROM category
    WHERE user_id = #{userId}
      AND update_time &gt; #{since}
    ORDER BY update_time ASC
    LIMIT #{limit}
  </select>

  <select id="selectArticlesSince" resultMap="articleMap">
    SELECT *
    FROM article
    WHERE user_id = #{userId}
      AND update_time &gt; #{since}
    ORDER BY update_time ASC
    LIMIT #{limit}
  </select>

</mapper>
