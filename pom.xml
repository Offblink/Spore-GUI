<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.offblink</groupId>
  <artifactId>spore-gui</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>war</packaging>
  <name>spore-gui</name>
  <description>Spore 搜题内容管理系统（JFT 课设：严格 SSM——Spring + SpringMVC + MyBatis，无 Spring Boot，war 部署外部 Tomcat 9）</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- 课设口径 JDK 8：Spring 5.3.x 是最后一个支持 JDK 8 的主线，勿升 6.x/7.x -->
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <spring.version>5.3.31</spring.version>
    <mybatis-plus.version>3.5.5</mybatis-plus.version>
    <jackson.version>2.13.5</jackson.version>
    <jjwt.version>0.11.5</jjwt.version>
  </properties>

  <dependencies>
    <!-- Spring：IoC/AOP + SpringMVC + 事务 + JDBC 工具（建库脚本/事务管理器） -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <version>${spring.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
      <version>${spring.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-aop</artifactId>
      <version>${spring.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
      <version>${spring.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
      <version>${spring.version}</version>
    </dependency>

    <!-- AspectJ 织入：@Aspect 注解切面（权限校验 + 操作日志，评分表二·2 分） -->
    <dependency>
      <groupId>org.aspectj</groupId>
      <artifactId>aspectjweaver</artifactId>
      <version>1.9.22</version>
    </dependency>

    <!-- MyBatis-Plus：用非 boot 构件 mybatis-plus（自带 mybatis 3.5.15），
         SqlSessionFactory 由 spring-mvc 同款的 MybatisSqlSessionFactoryBean 在 XML 里装配。
         mybatis-spring 聚合构件不带，必须自己引（MapperScannerConfigurer/SqlSessionTemplate 都在它里面）。 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis-spring</artifactId>
      <version>2.1.2</version>
    </dependency>

    <!-- 连接池 + 驱动 -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>4.0.3</version>
    </dependency>
    <!-- 钉死 slf4j 1.7.x：HikariCP 4.0.3 会把 slf4j-api 拉到 2.0.0-alpha1，
         那是 ServiceLoader 机制，logback 1.2 的 StaticLoggerBinder 会被判无效 → 全场 NOP 日志 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.36</version>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.0.33</version>
      <scope>runtime</scope>
    </dependency>

    <!-- 参数校验：@Valid + Bean Validation（6.x = javax.validation 2.0，JDK 8 口径；
         EL 由 Tomcat 9 的 tomcat-embed-el 提供） -->
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
      <version>6.2.5.Final</version>
    </dependency>

    <!-- JSON：消息转换器 + java.time 类型（LocalDateTime 走 ISO 字符串，见 JacksonConfig） -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- 口令哈希：BCrypt（评分表二·数据安全；绝不明文存口令） -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
      <version>5.7.11</version>
    </dependency>

    <!-- token 签发/校验（局域网 Bearer token；运行时生成，不硬编码） -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- Servlet API：Tomcat 9（Servlet 4.0 / javax）提供，war 里不能打进 WEB-INF/lib -->
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>4.0.1</version>
      <scope>provided</scope>
    </dependency>

    <!-- @PostConstruct/@PreDestroy：同为容器提供（Tomcat 9 lib/annotations-api.jar）；
         JDK 11 起已从 JDK 移除，编译必须显式引 -->
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
      <scope>provided</scope>
    </dependency>

    <!-- 日志：logback（配置见 src/main/resources/logback.xml） -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>1.2.13</version>
    </dependency>
  </dependencies>

  <build>
    <!-- war 名固定：客户端把它部署成 Tomcat 的 ROOT.war（接口前缀必须是 /api，不能是 /spore-gui/api） -->
    <finalName>spore-gui</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.3.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
      </plugin>
    </plugins>
  </build>
</project>
